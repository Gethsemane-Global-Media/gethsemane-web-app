# ==============================================================================
# Gethsemane (Bible Experience) - Environment Configuration
# ==============================================================================

# Backend API Base URL (Rooted Laravel Domain Hub)
# - Local Development: http://localhost:8000/api/v1
# - Production Hosting: https://your-backend-domain.com/api/v1
VITE_ROOTED_API_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenRouter AI API Key (Optional: for dynamic "Do you know?" Bible insights)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
